{
  "manifest_version": 3,
  "name": "Hermes Browser Link",
  "version": "1.8.0",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "downloads",
    "storage",
    "alarms",
    "cookies",
    "notifications"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hermes Browser Link",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": "",
  "short_name": "Hermes Browser Link",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "description": "连接 Hermes 与已登录的 Chrome/Edge，支持智能审批、自动文本与截图屏蔽、持续任务鼠标及 Cookie 镜像。"
}
